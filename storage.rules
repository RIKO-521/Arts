rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Anyone can view images (profile photo, project covers/galleries).
    // Only a logged-in admin (that's you) can upload or delete.
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
